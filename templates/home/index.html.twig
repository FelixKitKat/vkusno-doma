
{% extends 'base.html.twig' %}

{% block title %}Главная — Вкусно дома{% endblock %}

{% block body %}

<section class="hero">
    <div class="container hero-content">
        <div class="hero-text">
            <span class="hero-label">ГОТОВИМ С ЛЮБОВЬЮ</span>
            <h1>Вкусно дома —<br>просто и с душой</h1>
            <p>
                Находите вдохновение, открывайте новые рецепты
                и радуйте близких вкусными домашними блюдами.
            </p>
            <a href="#popular" class="hero-button">Смотреть рецепты</a>
        </div>

        <div class="hero-decoration">
            <div class="hero-circle">
                <span>♥</span>
            </div>
        </div>
    </div>
</section>

<section class="popular container" id="popular">
    <div class="section-heading">
        <span class="section-label">ИДЕИ ДЛЯ ВАШЕГО СТОЛА</span>
        <h2>Популярные рецепты</h2>
        <p>Вкусные блюда, которые хочется приготовить снова</p>
    </div>

    <div class="recipe-grid">
        <article class="recipe-card">
            <div class="recipe-image">
                <img src="{{ asset('images/photo-1547592180-85f173990554.jfif') }}" alt="Домашний куриный суп">
                <span>СУПЫ</span>
            </div>
            <div class="recipe-info">
                <h3>Домашний куриный суп</h3>
                <p>Лёгкий, ароматный и очень уютный обед.</p>
                <span class="recipe-time">◷ 40 минут</span>
            </div>
        </article>

        <article class="recipe-card">
            <div class="recipe-image">
                <img src="{{ asset('images/photo-1464349095431-e9a21285b5f3.jfif') }}" alt="Свежий овощной салат">
                <span>САЛАТЫ</span>
            </div>
            <div class="recipe-info">
                <h3>Свежий овощной салат</h3>
                <p>Яркое сочетание свежих овощей и зелени.</p>
                <span class="recipe-time">◷ 15 минут</span>
            </div>
        </article>

        <article class="recipe-card">
            <div class="recipe-image">
                <img src="{{ asset('images/photo-1512621776951-a57141f2eefd.jfif') }}" alt="Домашний ягодный пирог">
                <span>ДЕСЕРТЫ</span>
            </div>
            <div class="recipe-info">
                <h3>Домашний ягодный пирог</h3>
                <p>Нежная выпечка для семейного чаепития.</p>
                <span class="recipe-time">◷ 60 минут</span>
            </div>
        </article>
    </div>
</section>

<style>
    .hero {
        background: #f5e7d8;
        padding: 85px 0;
    }

    .hero-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
    }

    .hero-text {
        max-width: 570px;
    }

    .hero-label,
    .section-label {
        color: #b85c38;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: 54px;
        line-height: 1.15;
        margin: 20px 0;
        color: #3d3029;
    }

    .hero-text p {
        color: #75665b;
        font-size: 17px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .hero-button {
        display: inline-block;
        background: #b85c38;
        color: white;
        padding: 15px 28px;
        border-radius: 6px;
        font-weight: 500;
        transition: background 0.2s;
    }

    .hero-button:hover {
        background: #98472b;
    }

    .hero-decoration {
        width: 330px;
        height: 330px;
        border-radius: 50%;
        background: #e7c6a8;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .hero-circle {
        width: 230px;
        height: 230px;
        border: 2px solid #fffaf4;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #b85c38;
        font-size: 90px;
    }

    .popular {
        padding-top: 75px;
        padding-bottom: 30px;
    }

    .section-heading {
        text-align: center;
        margin-bottom: 40px;
    }

    .section-heading h2 {
        font-family: 'Playfair Display', serif;
        font-size: 36px;
        margin: 12px 0;
    }

    .section-heading p {
        color: #82756b;
    }

    .recipe-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .recipe-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(61, 48, 41, 0.07);
    }

.recipe-image {
    height: 190px;
    position: relative;
    overflow: hidden;
}

.recipe-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.recipe-image span {
    position: absolute;
    bottom: 18px;
    left: 18px;
    background: white;
    color: #b85c38;
    padding: 7px 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

    .recipe-image span {
        background: white;
        color: #b85c38;
        padding: 7px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .soup-image {
        background: linear-gradient(135deg, #e8c8a5, #bd8b60);
    }

    .salad-image {
        background: linear-gradient(135deg, #c8d6a0, #7e9b63);
    }

    .dessert-image {
        background: linear-gradient(135deg, #edc1b1, #c98270);
    }

    .recipe-info {
        padding: 22px;
    }

    .recipe-info h3 {
        font-family: 'Playfair Display', serif;
        font-size: 21px;
        margin-bottom: 10px;
    }

    .recipe-info p {
        color: #82756b;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .recipe-time {
        color: #b85c38;
        font-size: 13px;
        font-weight: 500;
    }

    @media (max-width: 750px) {
        .hero-content {
            flex-direction: column;
            text-align: center;
        }

        .hero h1 {
            font-size: 40px;
        }

        .hero-decoration {
            width: 240px;
            height: 240px;
        }

        .hero-circle {
            width: 170px;
            height: 170px;
        }

        .recipe-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

{% endblock %}
