
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Вкусно дома{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background: #fffaf4;
            color: #3d3029;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            background: #ffffff;
            padding: 22px 0;
            border-bottom: 1px solid #f0e5d9;
        }

        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 30px;
            font-weight: 700;
            color: #b85c38;
        }

        nav {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        nav a {
            font-size: 15px;
            color: #51443b;
        }

        nav a:hover {
            color: #b85c38;
        }

        nav .add-recipe-link,
        nav .login-link {
            background: #b85c38;
            color: white;
            padding: 11px 17px;
            border-radius: 6px;
        }

        nav .add-recipe-link:hover,
        nav .login-link:hover {
            background: #98472b;
            color: white;
        }

        nav .logout-link {
            color: #b85c38;
            font-weight: 700;
        }

        main {
            min-height: 70vh;
        }

        footer {
            background: #3d3029;
            color: #fffaf4;
            padding: 28px 0;
            text-align: center;
            margin-top: 60px;
        }

        @media (max-width: 650px) {
            .header-inner {
                flex-direction: column;
                gap: 18px;
            }

            nav {
                gap: 15px;
                flex-wrap: wrap;
                justify-content: center;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body>

<header>
    <div class="container header-inner">
        <a href="{{ path('app_home') }}" class="logo">Вкусно дома</a>

        <nav>
            <a href="{{ path('app_home') }}">Главная</a>
            <a href="{{ path('app_recipes') }}">Рецепты</a>
            <a href="{{ path('app_recipes') }}">Категории</a>
            <a href="#about">О проекте</a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_recipe') }}" class="add-recipe-link">
                    + Добавить рецепт
                </a>
                <a href="{{ path('app_logout') }}" class="logout-link">
                    Выйти
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="login-link">
                    Войти
                </a>
            {% endif %}
        </nav>
    </div>
</header>

<main>
    {% block body %}{% endblock %}
</main>

<footer id="about">
    <div class="container">
        <p>© {{ "now"|date("Y") }} Вкусно дома — готовим с любовью!</p>
    </div>
</footer>

</body>
</html>
