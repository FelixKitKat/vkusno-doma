<section style="margin-top: 50px;">
    <h2>Отзывы о рецепте</h2>

    {% if recipe.reviews is not empty %}
        {% for review in recipe.reviews %}
            <div style="background: #fff; padding: 20px; margin: 15px 0; border-radius: 12px;">
                <strong>{{ review.author }}</strong>
                <p style="color: #b85c38;">
                    Оценка: {{ review.rating }} / 5
                </p>
                <p>{{ review.content }}</p>
            </div>
        {% endfor %}
    {% else %}
        <p>Пока отзывов нет. Будьте первым!</p>
    {% endif %}

    <a href="{{ path('app_review_new', {id: recipe.id}) }}" class="btn">
        Оставить отзыв
    </a>
</section>