{% extends 'base.html.twig' %}

{% block title %}Рецепты — Вкусно дома{% endblock %}

{% block body %}

<section class="catalog">
    <div class="container">
        <div class="catalog-heading">
            <span>НАШИ ВКУСНЫЕ ИДЕИ</span>
            <h1>Каталог рецептов</h1>
            <p>Выбирайте любимые блюда и вдохновляйтесь на новые кулинарные открытия!</p>
        </div>

        <div class="recipe-grid">
            {% for recipe in recipes %}
                <article class="recipe-card">
                    <div class="recipe-image">
                        <img
                            src="{{ asset('images/' ~ recipe.image) }}"
                            alt="{{ recipe.title }}"
                        >
                        <span>{{ recipe.category|upper }}</span>
                    </div>

                    <div class="recipe-info">
                        <h3>{{ recipe.title }}</h3>
                        <p>{{ recipe.description }}</p>

                        <div class="recipe-bottom">
                            <span class="recipe-time">◷ {{ recipe.time }} минут</span>

                            <a href="{{ path('app_recipe_detail', {id: loop.index}) }}"
                               class="recipe-link">
                                Читать рецепт →
                            </a>
                        </div>
                    </div>
                </article>
            {% else %}
                <p>Пока рецептов нет.</p>
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .catalog {
        padding: 65px 0;
    }

    .catalog-heading {
        text-align: center;
        margin-bottom: 45px;
    }

    .catalog-heading span {
        color: #b85c38;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .catalog-heading h1 {
        font-family: 'Playfair Display', serif;
        font-size: 42px;
        margin: 15px 0;
    }

    .catalog-heading p {
        color: #82756b;
        line-height: 1.6;
    }

    .recipe-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .recipe-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(61, 48, 41, 0.07);
        transition: transform 0.3s;
    }

    .recipe-card:hover {
        transform: translateY(-5px);
    }

    .recipe-image {
        height: 190px;
        position: relative;
        overflow: hidden;
    }

    .recipe-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .recipe-image span {
        position: absolute;
        bottom: 18px;
        left: 18px;
        background: white;
        color: #b85c38;
        padding: 7px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
    }

    .recipe-info {
        padding: 22px;
    }

    .recipe-info h3 {
        font-family: 'Playfair Display', serif;
        font-size: 21px;
        margin-bottom: 10px;
    }

    .recipe-info p {
        color: #82756b;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .recipe-bottom {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .recipe-time {
        color: #b85c38;
        font-size: 13px;
        font-weight: 500;
    }

    .recipe-link {
        color: #b85c38;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

    .recipe-link:hover {
        text-decoration: underline;
    }

    @media (max-width: 750px) {
        .recipe-grid {
            grid-template-columns: 1fr;
        }

        .catalog-heading h1 {
            font-size: 34px;
        }
    }
</style>

{% endblock %}
