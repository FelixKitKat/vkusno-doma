
{% extends 'base.html.twig' %}

{% block title %}Рецепты — Вкусно дома{% endblock %}

{% block body %}

<section class="catalog">
    <div class="container">
        <div class="catalog-heading">
            <span>НАШИ ВКУСНЫЕ ИДЕИ</span>
            <h1>Каталог рецептов</h1>
            <p>Выбирайте любимые блюда и вдохновляйтесь на новые кулинарные открытия!</p>
        </div>

        <div class="category-filters">
            <button class="category-button active" data-category="all">Все рецепты</button>
            <button class="category-button" data-category="супы">Супы</button>
            <button class="category-button" data-category="салаты">Салаты</button>
            <button class="category-button" data-category="десерты">Десерты</button>
        </div>

        <div class="recipe-search">
            <input
                type="text"
                id="recipeSearch"
                placeholder="🔍 Найти рецепт или категорию..."
                aria-label="Поиск рецептов"
            >
        </div>

        <div class="recipe-grid" id="recipeGrid">
            {% for recipe in recipes %}
                <article
                    class="recipe-card"
                    data-category="{{ recipe.category|lower }}"
                    data-search="{{ (recipe.title ~ ' ' ~ recipe.category ~ ' ' ~ recipe.description)|lower }}"
                >
                    <div class="recipe-image">
                        {% if recipe.image %}
                            <img
                                src="{{ asset('images/' ~ recipe.image) }}"
                                alt="{{ recipe.title }}"
                            >
                        {% else %}
                            <div class="no-image">Фото скоро появится</div>
                        {% endif %}

                        <span>{{ recipe.category|upper }}</span>
                    </div>

                    <div class="recipe-info">
                        <h3>{{ recipe.title }}</h3>
                        <p>{{ recipe.description }}</p>

                        <div class="recipe-bottom">
                            <span class="recipe-time">
                                ◷ {{ recipe.cookingTime }} минут
                            </span>

                            <a
                                href="{{ path('app_recipe_detail', {id: recipe.id}) }}"
                                class="recipe-link"
                            >
                                Читать рецепт →
                            </a>
                        </div>
                    </div>
                </article>
            {% else %}
                <p class="empty-catalog">
                    Пока рецептов нет. Скоро здесь появятся вкусные идеи!
                </p>
            {% endfor %}
        </div>

        <p id="noResults" class="no-results" hidden>
            К сожалению, ничего не найдено. Попробуйте изменить поиск или категорию.
        </p>
    </div>
</section>

<style>
    .catalog {
        padding: 65px 0;
    }

    .catalog-heading {
        text-align: center;
        margin-bottom: 35px;
    }

    .catalog-heading span {
        color: #b85c38;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .catalog-heading h1 {
        font-family: 'Playfair Display', serif;
        font-size: 42px;
        margin: 15px 0;
    }

    .catalog-heading p {
        color: #82756b;
        line-height: 1.6;
    }

    .category-filters {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 30px;
    }

    .category-button {
        padding: 11px 22px;
        border: 1px solid #e5d5c8;
        border-radius: 25px;
        background: white;
        color: #3d3029;
        font-size: 14px;
        cursor: pointer;
        transition: 0.3s;
    }

    .category-button:hover,
    .category-button.active {
        background: #b85c38;
        color: white;
        border-color: #b85c38;
    }

    .recipe-search {
        max-width: 550px;
        margin: 0 auto 40px;
    }

    .recipe-search input {
        width: 100%;
        padding: 15px 20px;
        border: 1px solid #e5d5c8;
        border-radius: 8px;
        background: white;
        color: #3d3029;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

    .recipe-search input:focus {
        border-color: #b85c38;
        box-shadow: 0 0 0 3px rgba(184, 92, 56, 0.1);
    }

    .recipe-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

    .recipe-card {
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(61, 48, 41, 0.07);
        transition: transform 0.3s;
    }

    .recipe-card:hover {
        transform: translateY(-5px);
    }

    .recipe-card[hidden] {
        display: none;
    }

    .recipe-image {
        height: 190px;
        position: relative;
        overflow: hidden;
        background: #f0e5da;
    }

    .recipe-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .recipe-image span {
        position: absolute;
        bottom: 18px;
        left: 18px;
        background: white;
        color: #b85c38;
        padding: 7px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
    }

    .no-image {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #82756b;
    }

    .recipe-info {
        padding: 22px;
    }

    .recipe-info h3 {
        font-family: 'Playfair Display', serif;
        font-size: 21px;
        margin-bottom: 10px;
    }

    .recipe-info p {
        color: #82756b;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .recipe-bottom {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .recipe-time {
        color: #b85c38;
        font-size: 13px;
        font-weight: 500;
    }

    .recipe-link {
        color: #b85c38;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

    .recipe-link:hover {
        text-decoration: underline;
    }

    .no-results,
    .empty-catalog {
        text-align: center;
        color: #82756b;
        padding: 30px 10px;
    }

    @media (max-width: 750px) {
        .recipe-grid {
            grid-template-columns: 1fr;
        }

        .catalog-heading h1 {
            font-size: 34px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('recipeSearch');
        const recipeCards = document.querySelectorAll('.recipe-card');
        const noResults = document.getElementById('noResults');
        const categoryButtons = document.querySelectorAll('.category-button');

        let selectedCategory = 'all';

        function filterRecipes() {
            const searchText = searchInput.value
                .trim()
                .toLocaleLowerCase('ru-RU');

            let visibleCount = 0;

            recipeCards.forEach(function (card) {
                const recipeText = card.dataset.search
                    .toLocaleLowerCase('ru-RU');

                const recipeCategory = card.dataset.category
                    .toLocaleLowerCase('ru-RU');

                const matchesSearch = recipeText.includes(searchText);

                const matchesCategory =
                    selectedCategory === 'all' ||
                    recipeCategory === selectedCategory;

                const isVisible = matchesSearch && matchesCategory;

                card.hidden = !isVisible;

                if (isVisible) {
                    visibleCount++;
                }
            });

            noResults.hidden = visibleCount > 0;
        }

        searchInput.addEventListener('input', filterRecipes);

        categoryButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                categoryButtons.forEach(function (item) {
                    item.classList.remove('active');
                });

                button.classList.add('active');
                selectedCategory = button.dataset.category;

                filterRecipes();
            });
        });
    });
</script>

{% endblock %}
