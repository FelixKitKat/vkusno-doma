
{% extends 'base.html.twig' %}

{% block title %}Вход администратора — Вкусно дома{% endblock %}

{% block body %}

<div class="login-container">

    <div class="login-card">

        <div class="login-icon">🍲</div>

        <h1>Вход администратора</h1>

        <p class="login-description">
            Войдите, чтобы управлять рецептами сайта.
        </p>

        {% if error %}
            <div class="login-error">
                Неверный адрес электронной почты или пароль.
            </div>
        {% endif %}

        {% if app.user %}
            <div class="login-success">
                Вы вошли как {{ app.user.userIdentifier }}.
                <a href="{{ logout_path() }}">Выйти</a>
            </div>
        {% endif %}

        <form method="post">

            <label for="username">Электронная почта</label>
            <input
                type="email"
                value="{{ last_username }}"
                name="_username"
                id="username"
                placeholder="Введите вашу почту"
                autocomplete="email"
                required
                autofocus
            >

            <label for="password">Пароль</label>
            <input
                type="password"
                name="_password"
                id="password"
                placeholder="Введите пароль"
                autocomplete="current-password"
                required
            >

            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit">Войти</button>

        </form>

        <a href="{{ path('app_home') }}" class="back-link">
            ← Вернуться на главную
        </a>

    </div>

</div>

<style>
    .login-container {
        min-height: 65vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        padding: 40px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(61, 48, 41, 0.08);
        text-align: center;
    }

    .login-icon {
        font-size: 45px;
    }

    .login-card h1 {
        font-family: 'Playfair Display', serif;
        color: #3d3029;
        font-size: 28px;
    }

    .login-description {
        color: #82756b;
        margin-bottom: 30px;
    }

    .login-card form {
        text-align: left;
    }

    .login-card label {
        display: block;
        margin: 18px 0 8px;
        color: #3d3029;
        font-weight: 600;
    }

    .login-card input:not([type="hidden"]) {
        width: 100%;
        box-sizing: border-box;
        padding: 13px;
        border: 1px solid #e5d5c7;
        border-radius: 7px;
        font-size: 15px;
    }

    .login-card button {
        width: 100%;
        margin-top: 25px;
        padding: 14px;
        border: none;
        border-radius: 7px;
        background: #b85c38;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

    .login-card button:hover {
        background: #98472b;
    }

    .login-error {
        padding: 12px;
        margin-bottom: 15px;
        color: #a83232;
        background: #fce8e8;
        border-radius: 7px;
    }

    .login-success {
        margin-bottom: 15px;
        color: #367346;
    }

    .back-link {
        display: inline-block;
        margin-top: 25px;
        color: #b85c38;
        text-decoration: none;
    }
</style>

{% endblock %}
